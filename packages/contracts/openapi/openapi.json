            "minimum": 0,
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
