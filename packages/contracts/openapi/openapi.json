              "ok",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "uptimeSeconds": {
            "minimum": 0,
            "type": "number"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "status",
          "version",
          "timestamp",
          "uptimeSeconds"
        ],
        "type": "object"
      },
      "PreAuthCsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "csrfToken",
          "expiresAt"
        ],
        "type": "object"
      },
      "RequestIdentityPasswordResetDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "scopeType": {
            "enum": [
              "platform",
              "tenant"
            ],
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "scopeType",
          "email"
        ],
        "type": "object"
      }
    }
