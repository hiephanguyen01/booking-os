{
  "components": {
    "schemas": {
      "AcceptedResponseDto": {
        "properties": {
          "accepted": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      },
      "ActorDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "CompletedResponseDto": {
        "properties": {
          "completed": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "completed"
        ],
        "type": "object"
      },
      "CompleteIdentityPasswordDto": {
        "properties": {
          "newPassword": {
            "minLength": 12,
            "type": "string"
          },
          "scopeType": {
            "enum": [
              "platform",
              "tenant"
            ],
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "scopeType",
          "token",
          "newPassword"
        ],
        "type": "object"
      },
      "CurrentAuthenticationResponseDto": {
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/ActorDto"
          },
          "session": {
            "$ref": "#/components/schemas/PublicSessionDto"
          }
        },
        "required": [
          "actor",
          "session"
        ],
        "type": "object"
      },
      "HealthDependencyStatusDto": {
        "properties": {
          "latencyMs": {
            "minimum": 0,
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthDependencyStatusDto"
            },
            "type": "object"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "uptimeSeconds": {
            "minimum": 0,
            "type": "number"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "status",
          "version",
          "timestamp",
          "uptimeSeconds"
        ],
        "type": "object"
      },
      "LoginRequestDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LogoutResponseDto": {
        "properties": {
          "loggedOut": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "loggedOut"
        ],
        "type": "object"
      },
      "PreAuthCsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "csrfToken",
          "expiresAt"
        ],
        "type": "object"
      },
      "PublicSessionDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/SessionScopeDto"
          },
          "state": {
            "enum": [
              "active",
              "invitation_pending"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "scope"
        ],
        "type": "object"
      },
      "RequestIdentityPasswordResetDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "scopeType": {
            "enum": [
              "platform",
              "tenant"
            ],
            "type": "string"
          },
          "tenantId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "scopeType",
          "email"
        ],
        "type": "object"
      },
      "RevokeDeviceResponseDto": {
        "properties": {
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "revoked"
        ],
        "type": "object"
      },
      "RevokeOtherSessionsResponseDto": {
        "properties": {
          "revokedCount": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "revokedCount"
        ],
        "type": "object"
      },
      "SessionListResponseDto": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionSummaryDto"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "SessionResponseDto": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/PublicSessionDto"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "SessionScopeDto": {
        "properties": {
          "tenantId": {
            "format": "uuid",
            "type": "string"
          },
          "type": {
            "enum": [
              "platform",
              "tenant"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "SessionSummaryDto": {
        "properties": {
          "absoluteExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "hostname": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "idleExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "lastSeenAt": {
            "format": "date-time",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/SessionScopeDto"
          },
          "state": {
            "enum": [
              "active",
              "invitation_pending",
              "compromised",
              "revoked"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "scope",
          "hostname",
          "state",
          "current",
          "createdAt",
          "lastSeenAt",
          "idleExpiresAt",
          "absoluteExpiresAt"
        ],
        "type": "object"
      }
    }
  },
