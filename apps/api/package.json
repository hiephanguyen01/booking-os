{
  "name": "@booking-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "biome check src test prisma",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "prisma generate && node --test --import tsx \"test/**/*.test.ts\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@booking-os/contracts": "workspace:*",
    "@booking-os/observability": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@booking-os/testing": "workspace:*",
    "@booking-os/typescript-config": "workspace:*",
    "@nestjs/testing": "11.1.28",
    "@types/node": "catalog:",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "rimraf": "6.0.1",
    "supertest": "7.2.2",
    "tsx": "4.20.5",
    "typescript": "catalog:"
  }
}
