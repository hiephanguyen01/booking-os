{
  "name": "@booking-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "test:e2e": "node --test --import tsx \"test/**/*.test.ts\"",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@booking-os/contracts": "workspace:*",
    "@booking-os/observability": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@booking-os/typescript-config": "workspace:*",
    "@nestjs/testing": "11.1.28",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "rimraf": "6.0.1",
    "supertest": "7.2.2",
    "tsx": "4.20.5",
    "typescript": "catalog:"
  }
}
