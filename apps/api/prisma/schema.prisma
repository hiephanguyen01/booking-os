generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pendingActivation @map("pending_activation")
  active
  suspended
  disabled

  @@map("user_status")
}

enum IdentityScopeType {
  platform
  tenant

  @@map("identity_scope_type")
}

enum AuthSessionState {
  active
  invitationPending @map("invitation_pending")
  compromised
  revoked

  @@map("auth_session_state")
}

enum RoleScopeLevel {
  platform
  tenant

  @@map("role_scope_level")
}

enum TenantStatus {
  provisioning
  active
  suspended

  @@map("tenant_status")
}

enum TenantMembershipStatus {
  invited
  active
  suspended
  revoked

  @@map("tenant_membership_status")
}

enum MembershipInvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("membership_invitation_status")
}

model Tenant {
  id                      String                     @id @db.Uuid
  slug                    String                     @unique
  name                    String
  status                  TenantStatus               @default(provisioning)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  domains                 TenantDomain[]
  memberships             TenantMembership[]
  membershipInvitations   MembershipInvitation[]
  probes                  TenantProbe[]
  outboxEvents            OutboxEvent[]
  accountActivationTokens AccountActivationToken[]
  passwordResetTokens     PasswordResetToken[]
  roleAssignments         RoleAssignment[]
  authSessions            AuthSession[]
  authSessionTokens       AuthSessionToken[]
  securityAuditEvents     TenantSecurityAuditEvent[]

  @@index([status])
  @@map("tenants")
}

model User {
  id                            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedEmail               String                     @unique @map("normalized_email")
  displayEmail                  String                     @map("display_email")
  status                        UserStatus                 @default(pendingActivation)
  authorizationVersion          Int                        @default(1) @map("authorization_version")
  activatedAt                   DateTime?                  @db.Timestamptz(6) @map("activated_at")
  suspendedAt                   DateTime?                  @db.Timestamptz(6) @map("suspended_at")
  disabledAt                    DateTime?                  @db.Timestamptz(6) @map("disabled_at")
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                     DateTime                   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  passwordCredential            PasswordCredential?
  activationTokens              AccountActivationToken[]
  passwordResetTokens           PasswordResetToken[]
  memberships                   TenantMembership[]
  membershipInvitationsReceived MembershipInvitation[]     @relation("MembershipInvitationInvitee")
  membershipInvitationsSent     MembershipInvitation[]     @relation("MembershipInvitationInviter")
  roleAssignments               RoleAssignment[]
  authSessions                  AuthSession[]
  auditEventsAsActor            SecurityAuditEvent[]       @relation("SecurityAuditActor")
  auditEventsAsSubject          SecurityAuditEvent[]       @relation("SecurityAuditSubject")
  tenantAuditEventsAsActor      TenantSecurityAuditEvent[] @relation("TenantSecurityAuditActor")
  tenantAuditEventsAsSubject    TenantSecurityAuditEvent[] @relation("TenantSecurityAuditSubject")

  @@index([status])
  @@map("users")
}

model PasswordCredential {
  userId            String   @id @db.Uuid @map("user_id")
  passwordHash      String   @map("password_hash")
  algorithm         String   @default("argon2id") @db.VarChar(32)
  parameters        Json
  passwordChangedAt DateTime? @db.Timestamptz(6) @map("password_changed_at")
  createdAt         DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AccountActivationToken {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                @db.Uuid @map("user_id")
  scopeType            IdentityScopeType     @map("scope_type")
  tenantId             String?               @db.Uuid @map("tenant_id")
  invitationId         String?               @db.Uuid @map("invitation_id")
  hostname             String
  selector             String                @unique
  tokenHash            String                @db.Char(64) @map("token_hash")
  expiresAt            DateTime              @db.Timestamptz(6) @map("expires_at")
  consumedAt           DateTime?             @db.Timestamptz(6) @map("consumed_at")
  revokedAt            DateTime?             @db.Timestamptz(6) @map("revoked_at")
  createdAt            DateTime              @default(now()) @db.Timestamptz(6) @map("created_at")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipInvitation MembershipInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("account_activation_tokens")
}

model PasswordResetToken {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String            @db.Uuid @map("user_id")
  scopeType  IdentityScopeType @map("scope_type")
  tenantId   String?           @db.Uuid @map("tenant_id")
  hostname   String
  selector   String            @unique
  tokenHash  String            @db.Char(64) @map("token_hash")
  expiresAt  DateTime          @db.Timestamptz(6) @map("expires_at")
  consumedAt DateTime?         @db.Timestamptz(6) @map("consumed_at")
  revokedAt  DateTime?         @db.Timestamptz(6) @map("revoked_at")
  createdAt  DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TenantDomain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantMembership {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                 @db.Uuid @map("tenant_id")
  userId               String                 @db.Uuid @map("user_id")
  status               TenantMembershipStatus @default(invited)
  authorizationVersion Int                    @default(1) @map("authorization_version")
  acceptedAt           DateTime?              @db.Timestamptz(6) @map("accepted_at")
  suspendedAt          DateTime?              @db.Timestamptz(6) @map("suspended_at")
  revokedAt            DateTime?              @db.Timestamptz(6) @map("revoked_at")
  createdAt            DateTime               @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime               @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model MembershipInvitation {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                     @db.Uuid @map("tenant_id")
  normalizedEmail    String                     @map("normalized_email")
  invitedUserId      String?                    @db.Uuid @map("invited_user_id")
  intendedRoleKey    String                     @map("intended_role_key")
  status             MembershipInvitationStatus @default(pending)
  hostname           String
  selector           String                     @unique
  tokenHash          String                     @db.Char(64) @map("token_hash")
  expiresAt          DateTime                   @db.Timestamptz(6) @map("expires_at")
  acceptedAt         DateTime?                  @db.Timestamptz(6) @map("accepted_at")
  revokedAt          DateTime?                  @db.Timestamptz(6) @map("revoked_at")
  invitedByUserId    String                     @db.Uuid @map("invited_by_user_id")
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime                   @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedUser        User?                      @relation("MembershipInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedByUser      User                       @relation("MembershipInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  intendedRole       Role                       @relation(fields: [intendedRoleKey], references: [key], onDelete: Restrict, onUpdate: Cascade)
  activationTokens   AccountActivationToken[]

  @@index([tenantId])
  @@index([invitedUserId])
  @@index([invitedByUserId])
  @@index([expiresAt])
  @@map("membership_invitations")
}

model AuthSession {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String            @db.Uuid @map("user_id")
  scopeType            IdentityScopeType @map("scope_type")
  tenantId             String?           @db.Uuid @map("tenant_id")
  hostname             String
  state                AuthSessionState  @default(active)
  authorizationVersion Int               @map("authorization_version")
  version              Int               @default(1)
  idleExpiresAt        DateTime           @db.Timestamptz(6) @map("idle_expires_at")
  absoluteExpiresAt    DateTime           @db.Timestamptz(6) @map("absolute_expires_at")
  lastSeenAt           DateTime           @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  revokedAt            DateTime?          @db.Timestamptz(6) @map("revoked_at")
  revocationReason     String?            @map("revocation_reason")
  compromisedAt        DateTime?          @db.Timestamptz(6) @map("compromised_at")
  createdAt            DateTime           @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime           @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokens               AuthSessionToken[]

  @@index([userId])
  @@index([tenantId])
  @@index([hostname, state])
  @@index([idleExpiresAt, absoluteExpiresAt])
  @@map("auth_sessions")
}

model AuthSessionToken {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String            @db.Uuid @map("session_id")
  scopeType        IdentityScopeType @map("scope_type")
  tenantId         String?           @db.Uuid @map("tenant_id")
  selector         String            @unique
  tokenHash        String            @db.Char(64) @map("token_hash")
  issuedAt         DateTime          @default(now()) @db.Timestamptz(6) @map("issued_at")
  expiresAt        DateTime          @db.Timestamptz(6) @map("expires_at")
  replacedAt       DateTime?         @db.Timestamptz(6) @map("replaced_at")
  overlapUntil     DateTime?         @db.Timestamptz(6) @map("overlap_until")
  successorTokenId String?           @unique @db.Uuid @map("successor_token_id")
  reuseDetectedAt  DateTime?         @db.Timestamptz(6) @map("reuse_detected_at")
  revokedAt        DateTime?         @db.Timestamptz(6) @map("revoked_at")
  session          AuthSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  successorToken   AuthSessionToken? @relation("AuthSessionTokenSuccessor", fields: [successorTokenId], references: [id], onDelete: SetNull)
  predecessorToken AuthSessionToken? @relation("AuthSessionTokenSuccessor")

  @@index([sessionId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("auth_session_tokens")
}

model Role {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                   String                 @unique
  scopeLevel            RoleScopeLevel         @map("scope_level")
  isSystem              Boolean                @default(true) @map("is_system")
  createdAt             DateTime               @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  rolePermissions       RolePermission[]
  assignments           RoleAssignment[]
  membershipInvitations MembershipInvitation[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String           @unique
  scopeLevel      RoleScopeLevel   @map("scope_level")
  description     String
  createdAt       DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleAssignment {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @db.Uuid @map("user_id")
  roleId     String         @db.Uuid @map("role_id")
  scopeLevel RoleScopeLevel @map("scope_level")
  tenantId   String?        @db.Uuid @map("tenant_id")
  createdAt  DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  revokedAt  DateTime?      @db.Timestamptz(6) @map("revoked_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant     Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@map("role_assignments")
}

model SecurityAuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String   @map("event_type")
  actorUserId   String?  @db.Uuid @map("actor_user_id")
  subjectUserId String?  @db.Uuid @map("subject_user_id")
  requestId     String?  @map("request_id")
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now()) @db.Timestamptz(6) @map("occurred_at")
  actorUser     User?    @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectUser   User?    @relation("SecurityAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([actorUserId])
  @@index([subjectUserId])
  @@map("security_audit_events")
}

model TenantSecurityAuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  eventType     String   @map("event_type")
  actorUserId   String?  @db.Uuid @map("actor_user_id")
  subjectUserId String?  @db.Uuid @map("subject_user_id")
  requestId     String?  @map("request_id")
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now()) @db.Timestamptz(6) @map("occurred_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser     User?    @relation("TenantSecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectUser   User?    @relation("TenantSecurityAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([eventType, occurredAt])
  @@index([actorUserId])
  @@index([subjectUserId])
  @@map("tenant_security_audit_events")
}

model TenantProbe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_probes")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  tenantId       String?   @db.Uuid @map("tenant_id")
  type           String
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @db.Uuid @map("aggregate_id")
  payload        Json
  occurredAt     DateTime  @default(now()) @db.Timestamptz(6) @map("occurred_at")
  availableAt    DateTime  @default(now()) @db.Timestamptz(6) @map("available_at")
  dispatchedAt   DateTime? @db.Timestamptz(6) @map("dispatched_at")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  firstFailedAt  DateTime? @db.Timestamptz(6) @map("first_failed_at")
  lastFailedAt   DateTime? @db.Timestamptz(6) @map("last_failed_at")
  deadLetteredAt DateTime? @db.Timestamptz(6) @map("dead_lettered_at")
  claimedAt      DateTime? @db.Timestamptz(6) @map("claimed_at")
  claimToken     String?   @db.Uuid @map("claim_token")
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([availableAt, dispatchedAt, deadLetteredAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @db.Uuid
  source      String
  externalId  String    @map("external_id")
  payloadHash String    @map("payload_hash")
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6) @map("received_at")
  processedAt DateTime? @db.Timestamptz(6) @map("processed_at")

  @@unique([source, externalId])
  @@map("inbox_messages")
}
