  revokedAt    DateTime?        @db.Timestamptz(6) @map("revoked_at")
  membership   TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "tenant_custom_role_assignments_membership_tenant_fkey")
  role         TenantCustomRole @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "tenant_custom_role_assignments_role_tenant_fkey")

  @@index([tenantId])
  @@index([membershipId])
  @@index([roleId])
  @@map("tenant_custom_role_assignments")
}

