generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String        @id @db.Uuid
  slug         String        @unique
  name         String
  createdAt    DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  probes       TenantProbe[]
  outboxEvents OutboxEvent[]

  @@map("tenants")
}

model TenantProbe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_probes")
}

model OutboxEvent {
  id             String    @id @db.Uuid
  tenantId       String?   @db.Uuid @map("tenant_id")
  type           String
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @db.Uuid @map("aggregate_id")
  payload        Json
  occurredAt     DateTime  @default(now()) @db.Timestamptz(6) @map("occurred_at")
  availableAt    DateTime  @default(now()) @db.Timestamptz(6) @map("available_at")
  dispatchedAt   DateTime? @db.Timestamptz(6) @map("dispatched_at")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  firstFailedAt  DateTime? @db.Timestamptz(6) @map("first_failed_at")
  lastFailedAt   DateTime? @db.Timestamptz(6) @map("last_failed_at")
  deadLetteredAt DateTime? @db.Timestamptz(6) @map("dead_lettered_at")
  claimedAt      DateTime? @db.Timestamptz(6) @map("claimed_at")
  claimToken     String?   @db.Uuid @map("claim_token")
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([availableAt, dispatchedAt, deadLetteredAt])
  @@index([tenantId])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @db.Uuid
  source      String
  externalId  String    @map("external_id")
  payloadHash String    @map("payload_hash")
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6) @map("received_at")
  processedAt DateTime? @db.Timestamptz(6) @map("processed_at")

  @@unique([source, externalId])
  @@map("inbox_messages")
}
