model TenantCustomRole {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                       @db.Uuid @map("tenant_id")
  name            String
  normalizedName  String                       @map("normalized_name")
  description     String?
  version         Int                          @default(1)
  archivedAt      DateTime?                    @db.Timestamptz(6) @map("archived_at")
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime                     @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions TenantCustomRolePermission[]
  assignments     TenantCustomRoleAssignment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("tenant_custom_roles")
}

model TenantCustomRolePermission {
  tenantId     String           @db.Uuid @map("tenant_id")
  roleId       String           @db.Uuid @map("role_id")
  permissionId String           @db.Uuid @map("permission_id")
  createdAt    DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  role         TenantCustomRole @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "tenant_custom_role_permissions_role_tenant_fkey")
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("tenant_custom_role_permissions")
}

model TenantCustomRoleAssignment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
