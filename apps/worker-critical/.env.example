NODE_ENV=development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Must match the API envelope keyring for identity email events.
IDENTITY_ENVELOPE_KEYS={"identity-v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}
IDENTITY_ACTIVE_ENVELOPE_KEY_ID=identity-v1

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@booking.test
DATABASE_URL=postgresql://booking:booking@127.0.0.1:5432/booking_os

