{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesis Feature metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "owner",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "implementing",
        "verified",
        "released",
        "deprecated"
      ]
    }
  },
  "additionalProperties": true
}
