{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesis Pattern metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "status",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PAT-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "standard",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
