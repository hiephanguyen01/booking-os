{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesis ADR metadata",
  "type": "object",
  "required": ["id", "title", "status", "owner", "date"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": ["proposed", "accepted", "superseded", "deprecated", "rejected"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": true
}
